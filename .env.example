# Copy this file to .env and fill in the keys for whichever providers you
# actually have accounts with. modelrouter.config.Settings reads these — see
# config.py's docstring. Every line here is optional: only set what you use.
# Ollama needs no key at all (it's a local server) and is always available.

# --- Native adapters (their own SDK, not OpenAI-wire-compatible) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- OpenAI-wire-compatible (routed through OpenAICompatibleAdapter) ---
GROQ_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=

# Adding a new OpenAI-wire-compatible provider later needs no code change —
# set <PROVIDER_NAME_UPPER>_API_KEY here and it's picked up automatically by
# Settings.build_adapters(); if it's not in config.KNOWN_PROVIDER_ENV_VARS,
# config.py still derives the same <NAME>_API_KEY convention for it.

# --- Storage tier (Law 1: one var switches every storage-backed subsystem —
# accounting, traces, evals, closed-loop, evidence, tenancy, BYOK vault) ---
# memory (default, nothing to configure) | sqlite | redis | postgres
MODELROUTER_STORAGE=memory
MODELROUTER_SQLITE_PATH=modelrouter.db
MODELROUTER_REDIS_URL=redis://localhost:6379/0
MODELROUTER_POSTGRES_DSN=postgresql://modelrouter:modelrouter@localhost:5432/modelrouter

# --- Redis reservation-ledger fast path (accounting/ledger.py) — separate
# from MODELROUTER_REDIS_URL above on purpose; point it at a different
# logical DB/cluster if you want the hot-path ledger isolated from the
# event log's own Redis traffic. Unset = the ledger is not used; the
# in-process (single-replica) reservation check is used instead. ---
MODELROUTER_REDIS_LEDGER_URL=redis://localhost:6379/1

# --- BYOK credential vault (tenancy/byok.py) — REQUIRED before storing any
# tenant's own provider key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this after keys are stored makes every stored key unrecoverable —
# treat it like a database password, never regenerate it per-deploy. ---
MODELROUTER_BYOK_MASTER_KEY=
# Production alternative: AWS KMS envelope encryption instead of a raw env
# var — see tenancy/byok.py's resolve_kms_sealed_key(). MODELROUTER_BYOK_KMS_KEY_ID
# is the KMS CMK id/ARN; the wrapped data key it produces is what you'd store
# (e.g. in Secrets Manager) instead of MODELROUTER_BYOK_MASTER_KEY above.
MODELROUTER_BYOK_KMS_KEY_ID=

# --- Async trace publisher (observability/async_publish.py) — optional,
# additive; traces are always durably written to the event store above
# regardless of whether either of these is set. ---
MODELROUTER_TRACE_SQS_QUEUE_URL=
MODELROUTER_TRACE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MODELROUTER_TRACE_KAFKA_TOPIC=modelrouter.traces

# --- Evidence bundle signing (evidence/signing.py) ---
MODELROUTER_EVIDENCE_SIGNING_SECRET=

# --- SSO (identity/sso/) — see src/modelrouter/identity/README.md.
# Unset MODELROUTER_SSO_ENABLED means the whole subsystem is never constructed
# and its routes answer 404: absence is a supported state, not a degraded one.
# A deployment using API keys only needs none of this. ---
MODELROUTER_SSO_ENABLED=
# The EXACT callback URL registered with each identity provider. Never derived
# from an incoming request — a request-supplied redirect target is the
# open-redirect/token-theft hole that exact-match registration closes.
MODELROUTER_SSO_REDIRECT_URI=https://gateway.example.com/auth/sso/callback
# true  = first-time SSO login is granted a least-privilege `viewer` membership
#         (correct for org-owned SSO: authenticating against Acme's own IdP
#         means you are an Acme person)
# false = only pre-invited users may sign in
MODELROUTER_SSO_JIT_PROVISIONING=true

# --- AWS region, read by boto3 (SQS/KMS) when either is used above ---
AWS_REGION=us-east-1

# --- Prometheus scrape endpoint (GET /metrics). Spans EVERY tenant, so it
# authenticates as infrastructure rather than as a tenant: no tenant credential
# can reach it. Unset means the route 404s (fail closed) rather than publishing
# every customer's volume and spend openly. ---
MODELROUTER_METRICS_TOKEN=
